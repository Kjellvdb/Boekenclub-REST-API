{
  "name": "webservices-boekenclub",
  "version": "1.0.0",
  "description": "API voor een boekenclub",
  "main": "index.ts",
  "repository": "git@github.com:Kjellvdb/Boekenclub-REST-API.git",
  "license": "MIT",
  "private": true,
  "packageManager": "yarn@4.5.1",
  "scripts": {
    "lint": "eslint .",
    "migrate:dev": "prisma migrate dev",
    "start:dev": "tsx watch --env-file .env --inspect=0.0.0.0:9001 src/index.ts",
    "migrate:test": "env-cmd -f .env.test prisma migrate dev --skip-seed",
    "test": "env-cmd -f .env.test jest --runInBand",
    "test:coverage": "env-cmd -f .env.test jest --runInBand --coverage",
    "migrate:reset": "prisma migrate reset -f",
    "build": "tsc",
    "start:prod": "env-cmd -f .env node build/src/index.js"
  },
  "prisma": {
    "schema": "src/data/schema.prisma",
    "seed": "tsx ./src/data/seed.ts"
  },
  "dependencies": {
    "@koa/cors": "^5.0.0",
    "@koa/router": "^13.1.0",
    "@prisma/client": "^6.0.0",
    "argon2": "^0.41.1",
    "config": "^3.3.12",
    "helmet": "^8.0.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "koa": "^2.15.3",
    "koa-bodyparser": "^4.4.1",
    "koa-helmet": "^8.0.1",
    "koa2-swagger-ui": "^5.11.0",
    "node-cache": "^5.1.2",
    "prisma": "^6.0.0",
    "swagger-jsdoc": "^6.2.8",
    "winston": "^3.15.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@stylistic/eslint-plugin": "^2.9.0",
    "@types/config": "^3.3.5",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9",
    "@types/koa": "^2.15.0",
    "@types/koa-bodyparser": "^4.3.12",
    "@types/koa__cors": "^5.0.0",
    "@types/koa__router": "^12.0.4",
    "@types/node": "^22.8.2",
    "@types/supertest": "^6.0.2",
    "@types/swagger-jsdoc": "^6",
    "env-cmd": "^10.1.0",
    "eslint": "^9.13.0",
    "eslint-plugin-jest": "^28.9.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.12.1"
  },
  "engines": {
    "node": "22.11.0",
    "yarn": "4.5.1"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all"
  }
}
